{
	"$schema": "node_modules/wrangler/config-schema.json",
	// worker.ts envuelve al Worker que genera OpenNext (.open-next/worker.js) con la
	// caché del datacenter para las páginas prearmadas — ver ese archivo.
	"main": "worker.ts",
	"name": "neumaticos-trivium",
	"compatibility_date": "2026-07-12",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Id de la versión desplegada: va en la clave de caché de worker.ts, así cada
	// deploy empieza con la caché vacía.
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	// Definidas acá (repo privado) en vez de depender de "Variables and Secrets"
	// del dashboard: cada deploy de Workers Builds las pisaba por no usar
	// --keep-vars, así que quedaban vacías. Así quedan garantizadas siempre.
	"vars": {
		// Sin sucursal al final (antes terminaba en "/arguello") — cada fetch en
		// pos-api.ts arma /{sucursal}/productos, etc. según la sucursal elegida.
		"POS_API_BASE_URL": "https://trivium-erp.vercel.app/api/public",
		"MERCADOPAGO_ACCESS_TOKEN": "APP_USR-6323540170330488-071417-4413e75117545308b4946db2d376bbf4-3541709725",
		// GOCUOTAS_ENV: "sandbox" para probar contra su ambiente de pruebas,
		// cualquier otro valor (o ausente) usa producción — ver src/lib/gocuotas.ts.
		"GOCUOTAS_ENV": "production",
		"GOCUOTAS_API_KEY_PRODUCTION": "6447898-0ac4de0d-cc00-43b6-b2ed-c534d7cbf196",
		"GOCUOTAS_API_KEY_SANDBOX": "6447898-0124b010-2492-4d4d-84a4-c42be177ad77"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Backend del caché incremental de OpenNext (ISR/SSG). El nombre del
	// binding lo exige el override r2IncrementalCache — no cambiarlo.
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "neumaticos-trivium-cache"
		}
	],
	// v1 creó el DOQueueHandler (cola ISR de OpenNext); v2 lo borra, con sus
	// objetos y alarmas pendientes: la cola vivía despierta casi todo el día y
	// agotaba el límite gratuito de duración de Durable Objects (bloqueo de
	// cuenta del 2026-08-31). El sitio ahora es 100% estático y se refresca por
	// redeploy programado — ver open-next.config.ts y deploy.yml.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DOQueueHandler"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["DOQueueHandler"]
		}
	],
	"services": [
		{
			// Self-reference: necesario para el cache interno de OpenNext.
			// El nombre debe coincidir con "name" de arriba.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "neumaticos-trivium"
		}
	]
}
