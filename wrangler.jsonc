{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "neumaticos-trivium",
	"compatibility_date": "2026-07-12",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	// Definidas acá (repo privado) en vez de depender de "Variables and Secrets"
	// del dashboard: cada deploy de Workers Builds las pisaba por no usar
	// --keep-vars, así que quedaban vacías. Así quedan garantizadas siempre.
	"vars": {
		"GEMINI_MODEL": "gemini-2.0-flash-lite",
		// Sin sucursal al final (antes terminaba en "/arguello") — cada fetch en
		// pos-api.ts arma /{sucursal}/productos, etc. según la sucursal elegida.
		"POS_API_BASE_URL": "https://pos-neumaticos.vercel.app/api/public",
		"GOOGLE_AI_KEY": "AIzaSyCwuPQrjs0L9x_QnqLOmlHJ9VIX4wyBBOM",
		"MERCADOPAGO_ACCESS_TOKEN": "APP_USR-6323540170330488-071417-4413e75117545308b4946db2d376bbf4-3541709725"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference: necesario para el cache interno de OpenNext.
			// El nombre debe coincidir con "name" de arriba.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "neumaticos-trivium"
		}
	],
	// Almacenamiento del caché incremental (ver open-next.config.ts). Sin esto,
	// la revalidación no persiste entre isolates y cada isolate frío rehace el
	// render y el fetch al POS. El nombre del binding lo fija OpenNext y no se
	// puede cambiar. El bucket tiene que existir antes de deployar, o wrangler
	// falla con "The specified bucket does not exist".
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "neumaticos-trivium-cache"
		}
	]
}
